# Copy this file to `.env` and fill in values from your Supabase project:
# Supabase Dashboard → Project Settings → API.
# These are PUBLIC values (they ship inside the app). Never put the
# service_role / secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Optional — enables "Continue with Google" in development/production builds.
# Google Cloud Console → Credentials → OAuth 2.0 Client IDs → *Web application* client ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
